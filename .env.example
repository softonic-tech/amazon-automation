# Copy this file to `.env` on the VPS and fill in real values.
# The systemd service loads it as an EnvironmentFile.
#
# The real .env is git-ignored (see .gitignore) so it never lands in the repo.

# ---- Keepa ----------------------------------------------------------------
# Required. Get from https://keepa.com/#!api
KEEPA_API_KEY=replace_me

# ---- App login (branded login page on the app itself) ---------------------
# The username + password the client uses in their browser.
APP_USERNAME=zeshan
APP_PASSWORD=change_this_to_a_strong_password

# Signs the login session cookie. MUST be stable across restarts, otherwise
# every user gets logged out on redeploy. Generate one with:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_hex_string

# Set to 1 once you're serving over HTTPS (so the cookie only travels on TLS).
# Leave unset for plain-HTTP deployments — otherwise nobody can log in.
# SESSION_COOKIE_SECURE=1

# ---- Server binding -------------------------------------------------------
# Port the Flask/gunicorn app binds to on localhost (nginx proxies to this).
# Leave 5000 unless you need to change it.
PORT=5000
